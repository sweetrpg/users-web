<nav class="nav">
  <div class="nav-brand">
    <a href="#(meta.rootURL)">
      <img src="#(meta.sharedURL)/static/img/sweetrpg-logo-black.svg" alt="SweetRPG" class="nav-logo nav-logo-light">
      <img src="#(meta.sharedURL)/static/img/sweetrpg-logo-white.svg" alt="SweetRPG" class="nav-logo nav-logo-dark">
    </a>
    <a href="#(meta.basePath)/profile">#(meta.l10n.nav_brand)</a>
  </div>
  <div class="nav-spacer"></div>
  <div class="app-switcher">
    <button type="button" class="app-switcher-trigger" aria-label="#(meta.l10n.nav_switch_app)">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="5" cy="5" r="2"/><circle cx="12" cy="5" r="2"/><circle cx="19" cy="5" r="2"/>
        <circle cx="5" cy="12" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="19" cy="12" r="2"/>
        <circle cx="5" cy="19" r="2"/><circle cx="12" cy="19" r="2"/><circle cx="19" cy="19" r="2"/>
      </svg>
    </button>
    <div class="app-switcher-panel" hidden>
      <a class="app-switcher-item" href="/">#(meta.l10n.nav_app_main)</a>
      <a class="app-switcher-item" href="/catalog">#(meta.l10n.nav_app_catalog)</a>
      <a class="app-switcher-item" href="/shelf">#(meta.l10n.nav_app_shelf)</a>
      <a class="app-switcher-item" href="/users">#(meta.l10n.nav_app_profile)</a>
      <a class="app-switcher-item" href="/initiative">#(meta.l10n.nav_app_initiative)</a>
    </div>
  </div>
  <div class="avatar-menu">
    <button type="button" class="avatar-menu-trigger">
      #if(user):
        #if(user.avatarGravatarURL):
        <img class="avatar-menu-avatar" src="#(user.avatarGravatarURL)" alt="" loading="lazy" onload="this.nextElementSibling.style.display='none'" onerror="this.style.display='none'">
        #endif
        <span class="avatar-menu-fallback">#(user.avatarInitial)</span>
      #else:
        <img class="avatar-menu-avatar" src="#(meta.sharedURL)/static/img/mystery-man.svg" alt="">
      #endif
    </button>
    <div class="avatar-menu-panel" hidden>
      #if(user):
        <div class="avatar-menu-identity">
          <span class="avatar-menu-name">#(user.name)</span>
          #if(user.email):
          <span class="avatar-menu-email">#(user.email)</span>
          #endif
        </div>
        <hr class="avatar-menu-divider">
        #if(user.isAdmin):
        <a class="avatar-menu-item" href="#(meta.adminURL)">#(meta.l10n.user_administration)</a>
        <hr class="avatar-menu-divider">
        #endif
        <form action="#(meta.logoutURL)" method="post" class="avatar-menu-item-form">
          <button type="submit" class="avatar-menu-item avatar-menu-item-danger">#(meta.l10n.user_log_out)</button>
        </form>
      #else:
        <a class="avatar-menu-item" href="#(meta.loginURL)">#(meta.l10n.user_log_in)</a>
      #endif
      <hr class="avatar-menu-divider">
      <div id="avatar-menu-theme-row" class="avatar-menu-theme-row" role="group" aria-label="#(meta.l10n.theme_group)">
        <button type="button" class="avatar-menu-theme-option" data-theme-choice="light" aria-label="#(meta.l10n.theme_light)"></button>
        <button type="button" class="avatar-menu-theme-option" data-theme-choice="dark" aria-label="#(meta.l10n.theme_dark)"></button>
        <button type="button" class="avatar-menu-theme-option" data-theme-choice="system" aria-label="#(meta.l10n.theme_system)"></button>
      </div>
    </div>
  </div>
</nav>
