#extend("base"):
  #export("title", "My Profile")
  #export("page"):
    <div class="profile-container">
      <h1>#(meta.l10n.profile_title)</h1>

      <div
        class="profile-fields"
        data-name="#(profile.name)"
        data-bio="#(profile.bio)"
        data-website="#(profile.website)"
        data-username="#(profile.username)"
        data-label-saved="#(meta.l10n.profile_saved)"
        data-label-save-failed="#(meta.l10n.profile_save_failed)"
        data-label-network-error="#(meta.l10n.profile_network_error)"
        data-label-name-required="#(meta.l10n.profile_name_required)"
        data-label-website-none="#(meta.l10n.profile_website_none)"
        data-label-username-invalid="#(meta.l10n.profile_username_invalid)"
      >
        <div class="profile-field" data-field="name">
          <label>#(meta.l10n.profile_name)</label>
          <div class="profile-field-value" tabindex="0" title="#(meta.l10n.profile_click_to_edit)">
            <span class="profile-field-display">#(profile.name)</span>
          </div>
        </div>

        <div class="profile-field" data-field="username">
          <label>#(meta.l10n.profile_username)</label>
          <div class="profile-field-value" tabindex="0" title="#(meta.l10n.profile_click_to_edit)">
            <span class="profile-field-display">#(profile.username)</span>
          </div>
          <small>#(meta.l10n.profile_username_help)</small>
        </div>

        <div class="profile-field">
          <label>#(meta.l10n.profile_email)</label>
          <p class="profile-field-readonly">#(profile.email)</p>
        </div>

        <div class="profile-field" data-field="bio">
          <label>#(meta.l10n.profile_bio)</label>
          <div class="profile-field-value" tabindex="0" title="#(meta.l10n.profile_click_to_edit)">
            <span class="profile-field-display">#(profile.bio)</span>
          </div>
          <small>#(meta.l10n.profile_bio_help)</small>
        </div>

        <div class="profile-field" data-field="website">
          <label>#(meta.l10n.profile_website)</label>
          <div class="profile-field-value" tabindex="0" title="#(meta.l10n.profile_click_to_edit)">
            #if(profile.website):
              <span class="profile-field-display">#(profile.website)</span>
            #else:
              <span class="profile-field-display profile-field-empty">#(meta.l10n.profile_website_none)</span>
            #endif
          </div>
          <small>#(meta.l10n.profile_website_help)</small>
        </div>
      </div>
    </div>

    <script src="#(meta.basePath)/profile-inline-edit.js" defer></script>

    <style>
      .profile-container { max-width: 560px; margin: 0 auto; }
      .profile-fields { display: flex; flex-direction: column; gap: var(--space-4); }
      .profile-field label {
        display: block; font-weight: 600; margin-bottom: var(--space-1);
      }
      .profile-field-readonly { margin: 0; color: var(--color-neutral-600); }
      .profile-field-value {
        border: 1px solid transparent; border-radius: var(--radius-md);
        padding: var(--space-1) var(--space-2); margin: 0 0 0 calc(var(--space-2) * -1);
        cursor: pointer; min-height: 1.5em;
      }
      .profile-field-value:hover, .profile-field-value:focus-visible {
        border-color: var(--color-divider); background: var(--color-surface);
        outline: none;
      }
      .profile-field-empty { color: var(--color-neutral-600); font-style: italic; }
      .profile-field-input {
        width: 100%; box-sizing: border-box; font: inherit;
      }
      textarea.profile-field-input { min-height: 90px; resize: vertical; }
      .profile-field-saving .profile-field-value { opacity: 0.6; }
      .profile-field-saved .profile-field-value {
        border-color: var(--color-accent);
        background: color-mix(in srgb, var(--color-accent) 12%, transparent);
      }
      .profile-field-error { color: #7a1212; font-size: 13px; margin-top: var(--space-1); }
      [data-theme="dark"] .profile-field-error { color: #f5a3a3; }
      .profile-field small { display: block; color: var(--color-neutral-600); margin-top: var(--space-1); }
    </style>
  #endexport
#endextend
